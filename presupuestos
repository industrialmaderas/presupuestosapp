<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#111827">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Presupuestos">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<title>Presupuestos | Industrial Maderas V2</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f3f4f6;color:#1f2937}
header{background:#111827;color:white;padding:22px 28px}
header h1{margin:0;font-size:25px}
header p{margin:5px 0 0;color:#cbd5e1}
.container{max-width:850px;margin:12px auto;padding:0 12px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.card{background:white;border-radius:14px;padding:20px;box-shadow:0 3px 14px #00000012;margin-bottom:18px}
.card h2{font-size:18px;margin:0 0 16px}
.field{margin-bottom:13px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
label{display:block;font-size:13px;font-weight:bold;margin-bottom:6px}
input,select{width:100%;height:46px;border:1px solid #cbd5e1;border-radius:10px;padding:0 12px;font-size:16px;background:#fff}
button{border:0;border-radius:9px;padding:10px 15px;font-weight:bold;cursor:pointer;background:#2563eb;color:white}
button.secondary{background:#e5e7eb;color:#111827}
button.danger{background:#dc2626;padding:9px 12px}
button.add{background:#059669;margin-top:5px}
.note{font-size:12px;color:#6b7280;margin-top:6px}
.material-row{border:1px solid #e5e7eb;border-radius:10px;padding:13px;margin-bottom:10px;background:#fafafa}
.material-grid{display:grid;grid-template-columns:1.1fr 1.1fr .8fr 1.3fr auto;gap:9px;align-items:end}
.pipe-grid{display:grid;grid-template-columns:1.1fr 1fr .8fr .9fr auto;gap:9px;align-items:end}
.row-title{font-size:12px;font-weight:bold;color:#6b7280;margin-bottom:7px}
.result{background:#111827;color:white;border-radius:14px;padding:22px}
.result .line{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #374151}
.total{font-size:28px;font-weight:bold;padding-top:16px}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.print-only{display:none}
@media(max-width:850px){.grid{grid-template-columns:1fr}.material-grid,.pipe-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.row,.material-grid,.pipe-grid{grid-template-columns:1fr}.actions{grid-template-columns:1fr}.card{padding:14px}.container{padding:9px}}
@media(max-width:560px){
 .row,.material-grid,.pipe-grid{grid-template-columns:1fr}
}
@media print{
 body{background:white}
 header,.app-ui{display:none!important}
 .print-only{display:block}
 .print-budget{padding:0;font-family:Arial,sans-serif;color:#111}
 .print-budget h1{font-size:22px;margin:0 0 4px}
 .print-budget .sub{font-size:12px;color:#555;margin-bottom:18px}
 .print-info{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:18px}
 .print-table{width:100%;border-collapse:collapse;margin:10px 0 18px}
 .print-table th,.print-table td{border:1px solid #ccc;padding:6px;text-align:left;font-size:11px}
 .print-table th{background:#eee}
 .print-total{font-size:22px;font-weight:bold;border-top:2px solid #111;padding-top:10px;text-align:right}
}
</style>
</head>
<body>
<header>
<h1>Industrial Maderas — Presupuestos</h1>
<p>Calculadora V2.1 · optimizada para celular y PC</p>
</header>

<div class="container app-ui">
<div class="grid">
<section>
<div class="card">
<h2>📋 Datos del presupuesto</h2>
<div class="field"><label>Cliente</label><input id="cliente" placeholder="Nombre del cliente"></div>
<div class="row">
<div class="field"><label>Producto</label><input id="producto" placeholder="Ej. Mesa plegable"></div>
<div class="field"><label>Cantidad</label><input id="cantidad" type="number" min="1" value="1"></div>
</div>
</div>

<div class="card">
<h2>🪵 Madera</h2>
<div class="row">
<div class="field"><label>Precio de la placa ($)</label><input id="maderaPrecio" type="number" value="38000"></div>
<div class="field"><label>Superficie de placa (m²)</label><input id="maderaSuperficie" type="number" step="0.01" value="3.6"></div>
</div>
<div class="field">
<label>Pérdida de madera (%)</label>
<input id="perdidaMadera" type="number" value="10">
</div>
<div id="maderaRows"></div>
<button class="add" onclick="agregarMadera()">＋ Agregar pieza de madera</button>
</div>

<div class="card">
<h2>🔩 Caños</h2>
<div class="field"><label>Pérdida de caño (%)</label><input id="perdidaCano" type="number" value="10"></div>
<div id="canoRows"></div>
<button class="add" onclick="agregarCano()">＋ Agregar tipo de caño</button>
<div class="note">El costo de caño se calcula sobre las barras compradas. Podés cargar distintos tipos y cantidades dentro del mismo presupuesto.</div>
</div>
</section>

<section>
<div class="card">
<h2>⚙️ Costos y porcentajes</h2>
<div class="row">
<div class="field"><label>Mano de obra (%)</label><input id="manoObra" type="number" value="100"></div>
<div class="field"><label>Otros (%)</label><input id="otros" type="number" value="50"></div>
</div>
<div class="row">
<div class="field"><label>Envío (%)</label><input id="envio" type="number" value="5"></div>
<div class="field"><label>Gastos extras ($)</label><input id="extras" type="number" value="0"></div>
</div>
<div class="field"><label>Instalación ($)</label><input id="instalacion" type="number" value="0"></div>
<div class="note">Los porcentajes de mano de obra, otros y envío se aplican sobre el costo base: madera + pérdidas + caño + pérdidas + gastos extras + instalación.</div>
</div>

<div class="card">
<h2>💰 Resultado</h2>
<div class="result">
<div class="line"><span>Madera</span><strong id="rMadera">$0</strong></div>
<div class="line"><span>Pérdida madera</span><strong id="rPMadera">$0</strong></div>
<div class="line"><span>Caño</span><strong id="rCano">$0</strong></div>
<div class="line"><span>Pérdida caño</span><strong id="rPCano">$0</strong></div>
<div class="line"><span>Gastos extras</span><strong id="rExtras">$0</strong></div>
<div class="line"><span>Instalación</span><strong id="rInstalacion">$0</strong></div>
<div class="line"><span>Base</span><strong id="rBase">$0</strong></div>
<div class="line"><span>Mano de obra</span><strong id="rMO">$0</strong></div>
<div class="line"><span>Otros</span><strong id="rOtros">$0</strong></div>
<div class="line"><span>Envío</span><strong id="rEnvio">$0</strong></div>
<div class="total">PRECIO FINAL <span style="float:right" id="rTotal">$0</span></div>
</div>
<div class="actions">
<button onclick="prepararImpresion()">🖨️ Imprimir / Guardar PDF</button>
<button class="secondary" onclick="resetear()">↻ Nuevo presupuesto</button>
</div>
</div>
</section>
</div>
</div>

<div id="printBudget" class="print-only print-budget"></div>

<script>
const $=id=>document.getElementById(id);
const money=n=>new Intl.NumberFormat("es-AR",{style:"currency",currency:"ARS",maximumFractionDigits:0}).format(n||0);
let maderaId=0, canoId=0;

function agregarMadera(data={}){
 maderaId++;
 const id=maderaId;
 const el=document.createElement("div");
 el.className="material-row";
 el.id="madera-"+id;
 el.innerHTML=`
 <div class="material-grid">
  <div><div class="row-title">Ancho (cm)</div><input class="m-ancho" type="number" min="0" step="0.1" value="${data.ancho||""}" oninput="calc()"></div>
  <div><div class="row-title">Alto/largo (cm)</div><input class="m-alto" type="number" min="0" step="0.1" value="${data.alto||""}" oninput="calc()"></div>
  <div><div class="row-title">Cantidad</div><input class="m-cantidad" type="number" min="1" value="${data.cantidad||1}" oninput="calc()"></div>
  <div><div class="row-title">Descripción (opcional)</div><input class="m-desc" type="text" value="${data.desc||""}" placeholder="Ej. Tapa"></div>
  <button class="danger" onclick="eliminarMadera(${id})">Eliminar</button>
 </div>`;
 $("maderaRows").appendChild(el);
 calc();
}
function eliminarMadera(id){
 const el=$("madera-"+id); if(el) el.remove(); calc();
}
function agregarCano(data={}){
 canoId++;
 const id=canoId;
 const el=document.createElement("div");
 el.className="material-row";
 el.id="cano-"+id;
 el.innerHTML=`
 <div class="pipe-grid">
  <div><div class="row-title">Tipo de caño</div>
   <select class="c-tipo" onchange="calc()">
    <option ${data.tipo==="20×20 mm"?"selected":""}>20×20 mm</option>
    <option ${data.tipo==="25×25 mm"?"selected":""}>25×25 mm</option>
    <option ${data.tipo==="30×30 mm"?"selected":""}>30×30 mm</option>
    <option ${data.tipo==="40×40 mm"?"selected":""}>40×40 mm</option>
    <option ${data.tipo==="50×50 mm"?"selected":""}>50×50 mm</option>
    <option ${data.tipo==="Otro"?"selected":""}>Otro</option>
   </select>
  </div>
  <div><div class="row-title">Precio por barra ($)</div><input class="c-precio" type="number" min="0" value="${data.precio||""}" oninput="calc()"></div>
  <div><div class="row-title">Metros por barra</div><input class="c-metros" type="number" min="0" step="0.1" value="${data.metros||6}" oninput="calc()"></div>
  <div><div class="row-title">Cantidad de barras</div><input class="c-cantidad" type="number" min="0" step="1" value="${data.cantidad||0}" oninput="calc()"></div>
  <button class="danger" onclick="eliminarCano(${id})">Eliminar</button>
 </div>`;
 $("canoRows").appendChild(el);
 calc();
}
function eliminarCano(id){
 const el=$("cano-"+id); if(el) el.remove(); calc();
}
function calc(){
 let madera=0;
 document.querySelectorAll("#maderaRows .material-row").forEach(row=>{
   const ancho=+(row.querySelector(".m-ancho").value)||0;
   const alto=+(row.querySelector(".m-alto").value)||0;
   const cant=+(row.querySelector(".m-cantidad").value)||0;
   const mp=+$("maderaPrecio").value||0;
   const ms=+$("maderaSuperficie").value||1;
   const area=(ancho*alto)/10000;
   madera += mp*(area/ms)*cant;
 });
 const pm=madera*(+$("perdidaMadera").value||0)/100;

 let cano=0;
 document.querySelectorAll("#canoRows .material-row").forEach(row=>{
   const precio=+(row.querySelector(".c-precio").value)||0;
   const cant=+(row.querySelector(".c-cantidad").value)||0;
   cano += precio*cant;
 });
 const pc=cano*(+$("perdidaCano").value||0)/100;
 const extras=+$("extras").value||0, inst=+$("instalacion").value||0;
 const base=madera+pm+cano+pc+extras+inst;
 const mo=base*(+$("manoObra").value||0)/100;
 const otros=base*(+$("otros").value||0)/100;
 const envio=(base+mo+otros)*(+$("envio").value||0)/100;
 const total=(base+mo+otros+envio)*(+$("cantidad").value||1);

 $("rMadera").textContent=money(madera);
 $("rPMadera").textContent=money(pm);
 $("rCano").textContent=money(cano);
 $("rPCano").textContent=money(pc);
 $("rExtras").textContent=money(extras);
 $("rInstalacion").textContent=money(inst);
 $("rBase").textContent=money(base);
 $("rMO").textContent=money(mo);
 $("rOtros").textContent=money(otros);
 $("rEnvio").textContent=money(envio);
 $("rTotal").textContent=money(total);
 return {madera,pm,cano,pc,extras,inst,base,mo,otros,envio,total};
}
function prepararImpresion(){
 const r=calc();
 const fecha=new Date().toLocaleDateString("es-AR");
 let maderaRows="";
 document.querySelectorAll("#maderaRows .material-row").forEach(row=>{
   const a=row.querySelector(".m-ancho").value||0;
   const h=row.querySelector(".m-alto").value||0;
   const q=row.querySelector(".m-cantidad").value||0;
   const d=row.querySelector(".m-desc").value||"—";
   const costo=(+$("maderaPrecio").value||0)*(((+a||0)*(+h||0))/10000)/(+$("maderaSuperficie").value||1)*(+q||0);
   if((+a||0)>0 && (+h||0)>0 && (+q||0)>0) maderaRows+=`<tr><td>${d}</td><td>${a} × ${h} cm</td><td>${q}</td><td>${money(costo)}</td></tr>`;
 });
 let canoRows="";
 document.querySelectorAll("#canoRows .material-row").forEach(row=>{
   const t=row.querySelector(".c-tipo").value;
   const m=row.querySelector(".c-metros").value||0;
   const q=row.querySelector(".c-cantidad").value||0;
   const p=row.querySelector(".c-precio").value||0;
   if((+q||0)>0) canoRows+=`<tr><td>${t}</td><td>${m} m</td><td>${q}</td><td>${money((+p||0)*(+q||0))}</td></tr>`;
 });
 $("printBudget").innerHTML=`
  <h1>Industrial Maderas — Presupuesto</h1>
  <div class="sub">Fecha: ${fecha}</div>
  <div class="print-info">
   <div><strong>Cliente:</strong> ${$("cliente").value||"—"}</div>
   <div><strong>Producto:</strong> ${$("producto").value||"—"}</div>
   <div><strong>Cantidad:</strong> ${$("cantidad").value||1}</div>
  </div>
  <h3>Madera</h3>
  <table class="print-table"><tr><th>Descripción</th><th>Medida</th><th>Cantidad</th><th>Costo</th></tr>${maderaRows||"<tr><td colspan='4'>Sin piezas cargadas</td></tr>"}</table>
  <h3>Caños</h3>
  <table class="print-table"><tr><th>Tipo</th><th>Largo barra</th><th>Barras</th><th>Costo</th></tr>${canoRows||"<tr><td colspan='4'>Sin caños cargados</td></tr>"}</table>
  <h3>Resumen de costos</h3>
  <table class="print-table">
   <tr><td>Madera</td><td>${money(r.madera)}</td></tr>
   <tr><td>Pérdida madera</td><td>${money(r.pm)}</td></tr>
   <tr><td>Caño</td><td>${money(r.cano)}</td></tr>
   <tr><td>Pérdida caño</td><td>${money(r.pc)}</td></tr>
   <tr><td>Gastos extras</td><td>${money(r.extras)}</td></tr>
   <tr><td>Instalación</td><td>${money(r.inst)}</td></tr>
   <tr><td>Base</td><td>${money(r.base)}</td></tr>
   <tr><td>Mano de obra</td><td>${money(r.mo)}</td></tr>
   <tr><td>Otros</td><td>${money(r.otros)}</td></tr>
   <tr><td>Envío</td><td>${money(r.envio)}</td></tr>
  </table>
  <div class="print-total">PRECIO FINAL: ${money(r.total)}</div>`;
 window.print();
}
function resetear(){location.reload()}

$("maderaPrecio").addEventListener("input",calc);
$("maderaSuperficie").addEventListener("input",calc);
$("perdidaMadera").addEventListener("input",calc);
$("perdidaCano").addEventListener("input",calc);
$("manoObra").addEventListener("input",calc);
$("otros").addEventListener("input",calc);
$("envio").addEventListener("input",calc);
$("extras").addEventListener("input",calc);
$("instalacion").addEventListener("input",calc);
$("cantidad").addEventListener("input",calc);

for(let i=0;i<5;i++) agregarMadera();
for(let i=0;i<5;i++) agregarCano();
calc();
</script>
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => navigator.serviceWorker.register('./sw.js').catch(() => {}));
}
</script>
</body>
</html>
